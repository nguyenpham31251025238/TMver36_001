<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="860" prefWidth="1280" stylesheets="@theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tmver36.StaffReviewController">
  <left>
    <VBox minWidth="228" prefWidth="228" spacing="14" styleClass="sidebar">
      <HBox alignment="CENTER_LEFT" spacing="12">
        <Label styleClass="brand-mark" text="TM" />
        <VBox spacing="3">
          <Label styleClass="brand" text="TeacherMatch" />
          <Label styleClass="brand-sub" text="TALENT CONNECTION" />
        </VBox>
      </HBox>
      <Label styleClass="nav-caption" text="WORKSPACE / MATCHING" />
      <Button fx:id="nav_StaffDashboard" maxWidth="Infinity" styleClass="nav" text="Teacher Profile Pool" />
      <Button fx:id="nav_StaffReview" maxWidth="Infinity" styleClass="nav,active" text="Profile Review" />
      <Button fx:id="nav_InterviewWorkspace" maxWidth="Infinity" styleClass="nav" text="Interviews &amp; Feedback" />
      <Region VBox.vgrow="ALWAYS" />
      <HBox alignment="CENTER_LEFT" spacing="12">
        <Label alignment="CENTER" minHeight="50" minWidth="50" styleClass="avatar" text="LA" />
        <VBox spacing="4">
          <Label styleClass="sidebar-name" text="Linh Anh" />
          <Label styleClass="nav-foot" text="Matching Staff" />
        </VBox>
      </HBox>
      <Button fx:id="nav_Login" maxWidth="Infinity" styleClass="nav" text="Logout" />
    </VBox>
  </left>
  <center>
    <BorderPane>
      <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
          <Label styleClass="breadcrumb" text="Matching Staff / Profile Review" />
          <Region HBox.hgrow="ALWAYS" />
          <Label styleClass="badge,badge-green" text="LIVE SYNC" />
          <Label styleClass="muted" text="26/10/2026" />
          <Label alignment="CENTER" minHeight="36" minWidth="36" styleClass="avatar-small" text="LA" />
        </HBox>
      </top>
      <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
          <content>
            <VBox spacing="20" styleClass="content">
              <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="6">
                  <Label styleClass="page-title" text="Profile Review" />
                  <Label styleClass="muted" text="Verify candidate qualifications, documents, and checklist before marking qEP (Ready)." wrapText="true" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="field-label" text="Switch candidate:" />
                <ComboBox fx:id="teacherSelector" prefWidth="240" />
              </HBox>

              <!-- Candidate Identity Header Card -->
              <VBox spacing="14" styleClass="card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="14">
                  <StackPane fx:id="avatarContainer" minHeight="60" minWidth="60" prefHeight="60" prefWidth="60" />
                  <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label fx:id="teacherNameLabel" styleClass="section-title" text="Emily Martin" />
                    <Label fx:id="teacherSummaryLabel" styleClass="muted" text="United Kingdom · 3–5 years · CELTA, IELTS · Master's Degree in TESOL &amp; Applied Linguistics" wrapText="true" />
                    <Label fx:id="teacherMetaLabel" styleClass="body" text="Expected Salary: $1,500 - $2,000 · Start date: 01/12/2026 · Location: Hanoi" wrapText="true" />
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="statusBadgeLabel" styleClass="badge,badge-amber" text="qCV (Pending)" />
                </HBox>
              </VBox>

              <HBox alignment="TOP_LEFT" spacing="16">
                <!-- Left Column: Bio & Dynamic Teacher Documents -->
                <VBox spacing="16" styleClass="card" HBox.hgrow="ALWAYS">
                  <Label styleClass="section-title" text="Information &amp; Uploaded Documents" />
                  <VBox spacing="6">
                    <Label styleClass="field-label" text="Candidate Bio &amp; Teaching Summary" />
                    <TextArea fx:id="introductionArea" prefHeight="86" promptText="Candidate introduction..." text="" wrapText="true" />
                  </VBox>

                  <!-- Quick category action bar (also preserves legacy fx:ids for tests) -->
                  <HBox alignment="CENTER_LEFT" spacing="8">
                    <Button fx:id="reviewCvButton" styleClass="button-sm,secondary" text="Open CV" />
                    <Button fx:id="reviewCertButton" styleClass="button-sm,secondary" text="Open Certificate" />
                    <Button fx:id="reviewIntroButton" styleClass="button-sm,secondary" text="Watch Intro Video" />
                    <Button fx:id="reviewDemoButton" styleClass="button-sm,secondary" text="Watch Teaching Video" />
                  </HBox>

                  <!-- Dynamic Document Table populated from STORE.documents(teacherId) -->
                  <VBox fx:id="documentsTable" spacing="0" styleClass="table" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="0" styleClass="table-header">
                      <VBox alignment="CENTER_LEFT" maxWidth="300" minWidth="220" prefWidth="280" spacing="0" HBox.hgrow="ALWAYS">
                        <Label styleClass="table-head" text="DOCUMENT" wrapText="true" />
                      </VBox>
                      <VBox alignment="CENTER_LEFT" maxWidth="160" minWidth="120" prefWidth="140" spacing="0">
                        <Label styleClass="table-head" text="UPDATED" wrapText="true" />
                      </VBox>
                      <VBox alignment="CENTER_LEFT" maxWidth="210" minWidth="180" prefWidth="200" spacing="0">
                        <Label styleClass="table-head" text="ACTIONS" wrapText="true" />
                      </VBox>
                    </HBox>
                  </VBox>
                </VBox>

                <!-- Right Column: Persistent Checklist & Feedback Actions -->
                <VBox minWidth="380" prefWidth="420" spacing="14" styleClass="card">
                  <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label styleClass="section-title" text="Review Checklist" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="checklistProgressLabel" styleClass="small" text="3/5 verified" />
                  </HBox>
                  <CheckBox fx:id="checkPersonalInfo" text="Complete personal information &amp; degree/major" />
                  <CheckBox fx:id="checkReadableCv" text="Readable and consistent CV" />
                  <CheckBox fx:id="checkCertificates" text="Viewable teaching certificates" />
                  <CheckBox fx:id="checkVideos" text="Viewable intro / teaching video" />
                  <CheckBox fx:id="checkScheduleSlots" text="Declared interview availability slots" />

                  <VBox spacing="6">
                    <Label styleClass="field-label" text="Feedback / Comments to Teacher" />
                    <TextArea fx:id="commentsArea" prefHeight="96" promptText="Enter feedback or specify missing documents for the teacher..." text="" wrapText="true" />
                  </VBox>

                  <Label fx:id="reviewFeedbackBanner" managed="false" styleClass="feedback-banner" text="" visible="false" wrapText="true" />

                  <HBox spacing="10">
                    <Button fx:id="requestChangesButton" maxWidth="Infinity" styleClass="secondary" text="Request update" HBox.hgrow="ALWAYS" />
                    <Button fx:id="markQcvButton" maxWidth="Infinity" styleClass="secondary" text="Save as qCV" HBox.hgrow="ALWAYS" />
                  </HBox>
                  <Button fx:id="readyStatusButton" maxWidth="Infinity" styleClass="primary" text="Mark as ready (qEP)" />
                </VBox>
              </HBox>
            </VBox>
          </content>
        </ScrollPane>
      </center>
    </BorderPane>
  </center>
</BorderPane>
