<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="900" prefWidth="1360" stylesheets="@theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tmver36.TeacherProfileController">
  <left>
    <VBox minWidth="228" prefWidth="228" spacing="14" styleClass="sidebar">
      <HBox alignment="CENTER_LEFT" spacing="12">
        <Label styleClass="brand-mark" text="TM" />
        <VBox spacing="3">
          <Label styleClass="brand" text="TeacherMatch" />
          <Label styleClass="brand-sub" text="TALENT CONNECTION" />
        </VBox>
      </HBox>
      <Label styleClass="nav-caption" text="WORKSPACE / TEACHER" />
      <Button fx:id="nav_TeacherProfile" maxWidth="Infinity" styleClass="nav,active" text="My Profile" />
      <Button fx:id="nav_TeacherDocuments" maxWidth="Infinity" styleClass="nav" text="CV &amp; Documents" />
      <Button fx:id="nav_TeacherSchedule" maxWidth="Infinity" styleClass="nav" text="Availability &amp; Interviews" />
      <Button fx:id="nav_TeacherHistory" maxWidth="Infinity" styleClass="nav" text="Connection Status" />
      <Region VBox.vgrow="ALWAYS" />
      <VBox spacing="6" />
      <HBox alignment="CENTER_LEFT" spacing="12">
        <Label alignment="CENTER" minHeight="50" minWidth="50" styleClass="avatar" text="EM" />
        <VBox spacing="4">
          <Label styleClass="sidebar-name" text="Emily Martin" />
          <Label styleClass="nav-foot" text="Teacher" />
        </VBox>
      </HBox>
      <Button fx:id="nav_Login" maxWidth="Infinity" styleClass="nav" text="Logout" />
    </VBox>
  </left>
  <center>
    <BorderPane>
      <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
          <Label styleClass="breadcrumb" text="Teacher / My Profile" />
          <Region HBox.hgrow="ALWAYS" />
          <Label styleClass="badge,badge-gray" text="DEMO" />
          <Label styleClass="muted" text="14/10/2026" />
          <Label alignment="CENTER" minHeight="36" minWidth="36" styleClass="avatar-small" text="EM" />
        </HBox>
      </top>
      <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
          <content>
            <VBox spacing="22" styleClass="content">
              <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="7">
                  <Label styleClass="page-title" text="My Profile" />
                  <Label styleClass="muted" text="Information for Matching to introduce you to suitable partners." wrapText="true" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
              </HBox>
              <VBox spacing="16" styleClass="card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12">
                  <Label alignment="CENTER" minHeight="50" minWidth="50" styleClass="avatar" text="EM" />
                  <VBox spacing="5">
                    <Label styleClass="section-title" text="Emily Martin" />
                    <Label styleClass="muted" text="English Teacher · United Kingdom" />
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label styleClass="badge,badge-amber" text="Pending review" />
                </HBox>
                <Label maxWidth="Infinity" styleClass="note" text="Profile submitted on 14/10/2026. Update information when Matching requests." wrapText="true" />
              </VBox>
              <VBox spacing="16" styleClass="card" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                <Label styleClass="section-title" text="Personal Information" />
                <HBox alignment="CENTER_LEFT" spacing="12">
                  <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Full name" />
                    <TextField fx:id="fullNameField" prefWidth="280" promptText="" text="Emily Martin" />
                  </VBox>
                  <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Email" />
                    <TextField fx:id="emailField" prefWidth="280" promptText="" text="emily@example.com" />
                  </VBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12">
                  <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Nationality" />
                    <ComboBox fx:id="nationalityCombo" maxWidth="Infinity" prefWidth="230">
                      <items>
                        <FXCollections fx:factory="observableArrayList">
                          <String fx:value="United Kingdom" />
                          <String fx:value="Canada" />
                          <String fx:value="Australia" />
                          <String fx:value="Other" />
                        </FXCollections>
                      </items>
                      <value>
                        <String fx:value="United Kingdom" />
                      </value>
                    </ComboBox>
                  </VBox>
                  <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Phone number" />
                    <TextField fx:id="phoneField" prefWidth="280" promptText="" text="+44 7700 900123" />
                  </VBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12">
                  <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Teaching experience" />
                    <TextField fx:id="experienceCombo" prefWidth="280" promptText="" text="4 years" />
                  </VBox>
                  <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Target age group" />
                    <ComboBox fx:id="aboutArea" maxWidth="Infinity" prefWidth="230">
                      <items>
                        <FXCollections fx:factory="observableArrayList">
                          <String fx:value="Kindergarten" />
                          <String fx:value="Elementary School" />
                          <String fx:value="Junior high school" />
                          <String fx:value="High school" />
                          <String fx:value="Adult" />
                        </FXCollections>
                      </items>
                      <value>
                        <String fx:value="Preschool" />
                      </value>
                    </ComboBox>
                  </VBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12">
                  <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Preferred location" />
                    <TextField fx:id="locationCombo" prefWidth="280" promptText="" text="Hanoi, Danang" />
                  </VBox>
                  <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Available start date" />
                    <TextField fx:id="dateSelect" prefWidth="280" promptText="" text="01/12/2026" />
                  </VBox>
                </HBox>
                <VBox spacing="7">
                  <Label styleClass="field-label" text="About me" />
                  <TextArea fx:id="bioArea" prefHeight="92" promptText="" text="Experienced primary English teacher with a CELTA certificate. I enjoy building engaging lessons through games and collaborative activities." wrapText="true" />
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="12">
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="saveDraftButton" styleClass="secondary" text="Save draft" />
                  <Button fx:id="submitProfileButton" styleClass="primary" text="Submit profile for review" />
                </HBox>
              </VBox>
            </VBox>
          </content>
        </ScrollPane>
      </center>
    </BorderPane>
  </center>
</BorderPane>
