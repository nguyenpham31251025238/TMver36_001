<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="860" prefWidth="1280" stylesheets="@theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tmver36.TeacherDocumentsController">
  <left>
    <VBox minWidth="228" prefWidth="228" spacing="14" styleClass="sidebar">
      <HBox alignment="CENTER_LEFT" spacing="12">
        <Label styleClass="brand-mark" text="TM" />
        <VBox spacing="3">
          <Label styleClass="brand" text="TeacherMatch" />
          <Label styleClass="brand-sub" text="TALENT CONNECTION" />
        </VBox>
      </HBox>
      <Label styleClass="nav-caption" text="WORKSPACE / TEACHER" />
      <Button fx:id="nav_TeacherProfile" maxWidth="Infinity" styleClass="nav" text="My Profile" />
      <Button fx:id="nav_TeacherDocuments" maxWidth="Infinity" styleClass="nav,active" text="CV &amp; Documents" />
      <Button fx:id="nav_TeacherSchedule" maxWidth="Infinity" styleClass="nav" text="Availability &amp; Interviews" />
      <Button fx:id="nav_TeacherHistory" maxWidth="Infinity" styleClass="nav" text="Connection Status" />
      <Region VBox.vgrow="ALWAYS" />
      <HBox alignment="CENTER_LEFT" spacing="12">
        <Label alignment="CENTER" minHeight="50" minWidth="50" styleClass="avatar" text="EM" />
        <VBox spacing="4">
          <Label styleClass="sidebar-name" text="Emily Martin" />
          <Label styleClass="nav-foot" text="Teacher" />
        </VBox>
      </HBox>
      <Button fx:id="nav_Login" maxWidth="Infinity" styleClass="nav" text="Logout" />
    </VBox>
  </left>
  <center>
    <BorderPane>
      <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
          <Label styleClass="breadcrumb" text="Teacher / CV &amp; Documents" />
          <Region HBox.hgrow="ALWAYS" />
          <Label styleClass="badge,badge-green" text="LIVE SYNC" />
          <Label styleClass="muted" text="26/10/2026" />
          <Label alignment="CENTER" minHeight="36" minWidth="36" styleClass="avatar-small" text="EM" />
        </HBox>
      </top>
      <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
          <content>
            <VBox spacing="20" styleClass="content">
              <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="6">
                  <Label styleClass="page-title" text="CV &amp; Documents" />
                  <Label styleClass="muted" text="Upload and manage your CV, teaching certificates, and demo videos. Files are linked directly to your account and synced for Staff and Partner review." wrapText="true" />
                  <Label styleClass="muted" text="Note: Ensure your CV does not contain personal contact details or external links." textFill="#DC2626" wrapText="true" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
              </HBox>

              <VBox spacing="14" styleClass="card" HBox.hgrow="ALWAYS">
                <Label styleClass="section-title" text="Upload or Replace Document" />
                <HBox alignment="CENTER_LEFT" spacing="12">
                  <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Document category" />
                    <ComboBox fx:id="documentType" maxWidth="Infinity">
                      <items>
                        <FXCollections fx:factory="observableArrayList">
                          <String fx:value="CV" />
                          <String fx:value="Certificates" />
                          <String fx:value="Intro video" />
                          <String fx:value="Teaching video" />
                        </FXCollections>
                      </items>
                      <value>
                        <String fx:value="CV" />
                      </value>
                    </ComboBox>
                  </VBox>
                  <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Document display name" />
                    <TextField fx:id="documentName" promptText="Example: Teacher_CV.pdf" text="" />
                  </VBox>
                </HBox>
                <HBox alignment="BOTTOM_LEFT" spacing="12">
                  <Button fx:id="chooseFileButton" styleClass="secondary" text="Choose file from device" />
                  <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Selected file path or URL" />
                    <TextField fx:id="documentUrl" promptText="Select a local file or enter https://..." text="" />
                  </VBox>
                  <Button fx:id="addDocumentButton" styleClass="primary" text="Save &amp; Upload Document" />
                </HBox>
                <Label fx:id="uploadStatusLabel" maxWidth="Infinity" styleClass="note" text="Supported formats: PDF, DOC, DOCX, PNG, JPG, MP4, HTML. Uploaded files are stored per teacher profile and synced across roles." wrapText="true" />
              </VBox>

              <VBox spacing="14" styleClass="card" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                  <Label styleClass="section-title" text="My Uploaded Documents" />
                  <Region HBox.hgrow="ALWAYS" />
                  <!-- Legacy quick buttons kept hidden/accessible for automated test compatibility -->
                  <Button fx:id="viewCvButton" styleClass="button-sm,secondary" text="Open CV" />
                  <Button fx:id="viewCertificateButton" styleClass="button-sm,secondary" text="Open Certificate" />
                  <Button fx:id="viewIntroButton" styleClass="button-sm,secondary" text="Watch Intro" />
                  <Button fx:id="viewDemoButton" styleClass="button-sm,secondary" text="Watch Demo" />
                  <Button fx:id="deleteCvButton" managed="false" styleClass="button-sm,danger" text="Delete CV" visible="false" />
                </HBox>

                <VBox fx:id="documentsTable" spacing="0" styleClass="table">
                  <HBox alignment="CENTER_LEFT" spacing="0" styleClass="table-header">
                    <VBox alignment="CENTER_LEFT" maxWidth="320" minWidth="220" prefWidth="280" spacing="0" HBox.hgrow="ALWAYS">
                      <Label styleClass="table-head" text="DOCUMENT" wrapText="true" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" maxWidth="180" minWidth="140" prefWidth="160" spacing="0">
                      <Label styleClass="table-head" text="TYPE" wrapText="true" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" maxWidth="150" minWidth="110" prefWidth="130" spacing="0">
                      <Label styleClass="table-head" text="UPDATED" wrapText="true" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" maxWidth="280" minWidth="240" prefWidth="260" spacing="0">
                      <Label styleClass="table-head" text="ACTION" wrapText="true" />
                    </VBox>
                  </HBox>
                </VBox>
              </VBox>
            </VBox>
          </content>
        </ScrollPane>
      </center>
    </BorderPane>
  </center>
</BorderPane>
