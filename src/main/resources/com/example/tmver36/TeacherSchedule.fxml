<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="900" stylesheets="@theme.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tmver36.TeacherScheduleController">
  <left>
    <VBox minWidth="228" prefWidth="228" spacing="14" styleClass="sidebar">
      <HBox alignment="CENTER_LEFT" spacing="12">
        <Label styleClass="brand-mark" text="TM" />
        <VBox spacing="3">
          <Label styleClass="brand" text="TeacherMatch" />
          <Label styleClass="brand-sub" text="TALENT CONNECTION" />
        </VBox>
      </HBox>
      <Label styleClass="nav-caption" text="WORKSPACE / TEACHER" />
      <Button fx:id="nav_TeacherProfile" maxWidth="Infinity" styleClass="nav" text="My Profile" />
      <Button fx:id="nav_TeacherDocuments" maxWidth="Infinity" styleClass="nav" text="CV &amp; Documents" />
      <Button fx:id="nav_TeacherSchedule" maxWidth="Infinity" styleClass="nav,active" text="Availability &amp; Interviews" />
      <Button fx:id="nav_TeacherHistory" maxWidth="Infinity" styleClass="nav" text="Connection Status" />
      <Region VBox.vgrow="ALWAYS" />
      <HBox alignment="CENTER_LEFT" spacing="12">
        <Label alignment="CENTER" minHeight="50" minWidth="50" styleClass="avatar" text="EM" />
        <VBox spacing="4">
          <Label styleClass="sidebar-name" text="Emily Martin" />
          <Label styleClass="nav-foot" text="Teacher" />
        </VBox>
      </HBox>
      <Button fx:id="nav_Login" maxWidth="Infinity" styleClass="nav" text="Logout" />
    </VBox>
  </left>
  <center>
    <BorderPane>
      <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
          <Label styleClass="breadcrumb" text="Teacher / Availability &amp; Interviews" />
          <Region HBox.hgrow="ALWAYS" />
          <Label styleClass="badge,badge-gray" text="DEMO" />
          <Label styleClass="muted" text="14/10/2026" />
          <Label alignment="CENTER" minHeight="36" minWidth="36" styleClass="avatar-small" text="EM" />
        </HBox>
      </top>
      <center>
        <ScrollPane hbarPolicy="AS_NEEDED">
          <content>
            <VBox spacing="22" styleClass="content">
              <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="7">
                  <Label styleClass="page-title" text="Availability &amp; Interviews" />
                  <Label styleClass="muted" text="Partners select from available times. You confirm before schedule is finalized." wrapText="true" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
              </HBox>
              <VBox spacing="16" styleClass="card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12">
                  <Label styleClass="section-title" text="Available interview times" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label styleClass="badge,badge-gray" text="Vietnam Timezone - UTC+7" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12">
                  <VBox spacing="7">
                    <Label styleClass="field-label" text="Date" />
                    <DatePicker fx:id="availabilityDate" promptText="Select Date" />
                  </VBox>
                  <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="From" />
                    <ComboBox maxWidth="Infinity" prefWidth="230">
                      <items>
                        <FXCollections fx:factory="observableArrayList">
                          <String fx:value="09:00" />
                          <String fx:value="10:00" />
                          <String fx:value="14:00" />
                          <String fx:value="15:00" />
                        </FXCollections>
                      </items>
                      <value>
                        <String fx:value="14:00" />
                      </value>
                    </ComboBox>
                  </VBox>
                  <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="To" />
                    <ComboBox maxWidth="Infinity" prefWidth="230">
                      <items>
                        <FXCollections fx:factory="observableArrayList">
                          <String fx:value="10:00" />
                          <String fx:value="11:00" />
                          <String fx:value="15:00" />
                          <String fx:value="16:00" />
                        </FXCollections>
                      </items>
                      <value>
                        <String fx:value="15:00" />
                      </value>
                    </ComboBox>
                  </VBox>
                  <Button fx:id="addSlotButton" styleClass="primary" text="Add time slot" />
                </HBox>
                <VBox spacing="0" styleClass="table">
                  <HBox alignment="CENTER_LEFT" spacing="0" styleClass="table-header">
                    <VBox alignment="CENTER_LEFT" maxWidth="230" minWidth="230" prefWidth="230" spacing="0">
                      <Label maxWidth="214" styleClass="table-head" text="DATE" wrapText="true" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" maxWidth="270" minWidth="270" prefWidth="270" spacing="0">
                      <Label maxWidth="254" styleClass="table-head" text="TIME SLOT" wrapText="true" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" maxWidth="230" minWidth="230" prefWidth="230" spacing="0">
                      <Label maxWidth="214" styleClass="table-head" text="STATUS" wrapText="true" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" maxWidth="250" minWidth="250" prefWidth="250" spacing="0">
                      <Label maxWidth="234" styleClass="table-head" text="" wrapText="true" />
                    </VBox>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="0" styleClass="table-row">
                    <VBox alignment="CENTER_LEFT" maxWidth="230" minWidth="230" prefWidth="230" spacing="0">
                      <Label maxWidth="214" styleClass="table-text" text="16/10/2026" wrapText="true" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" maxWidth="270" minWidth="270" prefWidth="270" spacing="0">
                      <Label maxWidth="254" styleClass="table-text" text="14:00 - 15:00" wrapText="true" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" maxWidth="230" minWidth="230" prefWidth="230" spacing="0">
                      <Label styleClass="badge,badge-green" text="Available" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" maxWidth="250" minWidth="250" prefWidth="250" spacing="0">
                      <Button fx:id="removeSlotButton" styleClass="danger" text="Delete time" />
                    </VBox>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="0" styleClass="table-row">
                    <VBox alignment="CENTER_LEFT" maxWidth="230" minWidth="230" prefWidth="230" spacing="0">
                      <Label maxWidth="214" styleClass="table-text" text="19/10/2026" wrapText="true" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" maxWidth="270" minWidth="270" prefWidth="270" spacing="0">
                      <Label maxWidth="254" styleClass="table-text" text="09:00 - 10:00" wrapText="true" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" maxWidth="230" minWidth="230" prefWidth="230" spacing="0">
                      <Label styleClass="badge,badge-green" text="Available" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" maxWidth="250" minWidth="250" prefWidth="250" spacing="0">
                      <Button fx:id="removeSlot2Button" styleClass="danger" text="Delete time" />
                    </VBox>
                  </HBox>
                </VBox>
              </VBox>
              <VBox spacing="16" styleClass="card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12">
                  <Label styleClass="section-title" text="Pending requests for you" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label styleClass="badge,badge-amber" text="01 request" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12">
                  <Label alignment="CENTER" minHeight="50" minWidth="50" styleClass="avatar" text="BS" />
                  <VBox spacing="8">
                    <Label styleClass="section-title" text="Bright School · Online interview" />
                    <Label styleClass="muted" text="16/10/2026 · 14:00 - 14:30 · UTC+7" />
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="declineInterviewButton" styleClass="danger" text="Decline" />
                  <Button fx:id="acceptInterviewButton" styleClass="primary" text="Confirm attendance" />
                </HBox>
                <Label maxWidth="Infinity" styleClass="note" text="After your confirmation, Matching finalizes the schedule and provides the Meet link for both parties." wrapText="true" />
              </VBox>
              <VBox spacing="16" styleClass="card" HBox.hgrow="ALWAYS">
                <Label styleClass="section-title" text="Confirmed interviews" />
                <Label styleClass="body" text="Green English Center · 20/10/2026 · 10:00 - 10:30 · UTC+7" />
                <HBox alignment="CENTER_LEFT" spacing="12">
                  <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Meet link (mock, room not created)" />
                    <TextField prefWidth="280" promptText="" text="https://meet.google.com/xxx-yyyy-zzz" />
                  </VBox>
                  <Button fx:id="openMeetButton" styleClass="secondary" text="Open demo room" />
                </HBox>
              </VBox>
            </VBox>
          </content>
        </ScrollPane>
      </center>
    </BorderPane>
  </center>
</BorderPane>
